PORT=8081
DATABASE_URL=postgres://postgres:postgres@localhost:5433/auth_service?sslmode=disable
AUTH_ISSUER=http://localhost:8081
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Required in production. Set it to the complete PEM value of an RSA private key.
# AUTH_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
